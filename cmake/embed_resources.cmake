# Writes a C++ source holding files as byte arrays, for the Linux launcher's resources (thpsource2::resources::find; the Windows build links them with launcher.rc).
#   cmake -DOUTPUT=<file.cpp> -DRESOURCES="1=<path>;2=<path>" -P embed_resources.cmake
set(body "")
set(table "")
foreach(entry IN LISTS RESOURCES)
    string(REPLACE "=" ";" parts "${entry}")
    list(GET parts 0 id)
    list(GET parts 1 path)
    file(READ "${path}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    file(SIZE "${path}" size)
    string(APPEND body "const unsigned char resource_${id}[${size}] = {${hex}};\n")
    string(APPEND table "    if (id == ${id}) { size = ${size}; return resource_${id}; }\n")
endforeach()
file(WRITE "${OUTPUT}.tmp" "// generated by cmake/embed_resources.cmake\n#include <cstddef>\nnamespace thpsource2::resources {\nnamespace {\n${body}}\nconst unsigned char* find(int id, std::size_t& size) {\n${table}    size = 0;\n    return nullptr;\n}\n}  // namespace thpsource2::resources\n")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
