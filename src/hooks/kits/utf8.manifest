<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- opentony.exe and the x86-64 opentony_spike.exe: the process's ANSI code page is UTF-8 (Windows 10 1903 and later; older systems ignore it), so the narrow
     calls the game and its host make (getenv, fopen, CreateFileA, FindFirstFileA, GetModuleFileNameA) take any install path. With the system's own code page a
     letter outside it (Cyrillic on a Western Windows) became '?' and the program found no game files. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
